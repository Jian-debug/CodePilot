      "id": "file:electron/main.ts",
      "type": "file",
      "name": "main.ts",
      "filePath": "electron/main.ts",
      "summary": "Electron main process entry point that bootstraps the application, manages the embedded Next.js server lifecycle (Sentry init, port allocation, subprocess fork), registers IPC handlers for installation wizard, terminal, notifications, widget export, and proxy resolution, and provides background bridge mode with system tray and notification polling.",
      "tags": ["entry-point", "ipc-handler", "lifecycle", "service", "event-handler"],
      "complexity": "complex"
    },
    {
      "id": "file:electron/preload.ts",
      "type": "file",
      "name": "preload.ts",
      "filePath": "electron/preload.ts",
      "summary": "Preload script that exposes a secure contextBridge API for the renderer process, including filesystem path resolution, Electron versions, and IPC channels for install, dialog, terminal, notification, proxy, widget export, shell, and bridge operations.",
      "tags": ["preload", "security", "ipc-bridge", "context-isolation"],
      "complexity": "simple"
    },
